{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/web",
      "sourceRoot": "apps/web/src",
      "prefix": "nc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/web/src/main.ts",
            "tsConfig": "apps/web/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["packages/themes/src"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/web/public"
              },
              {
                "glob": "**/*",
                "input": "apps/shared-assets",
                "output": "/assets"
              }
            ],
            "styles": ["dist/tokens/css/variables.css", "apps/web/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web:build:production"
            },
            "development": {
              "buildTarget": "web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "apps/web/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["packages/themes/src"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/web/public"
              },
              {
                "glob": "**/*",
                "input": "apps/shared-assets",
                "output": "/assets"
              }
            ],
            "styles": ["dist/tokens/css/variables.css", "apps/web/src/styles.scss"]
          }
        }
      }
    },
    "docs": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/docs",
      "sourceRoot": "apps/docs/src",
      "prefix": "nc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/docs/src/main.ts",
            "tsConfig": "apps/docs/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["packages/themes/src"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/docs/public"
              },
              {
                "glob": "**/*",
                "input": "apps/shared-assets",
                "output": "/assets"
              }
            ],
            "styles": ["dist/tokens/css/variables.css", "apps/docs/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "docs:build:production"
            },
            "development": {
              "buildTarget": "docs:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "docs:build:development",
            "compodoc": false,
            "port": 6006,
            "quiet": true
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "docs:build:production",
            "compodoc": false,
            "outputDir": "storybook-static"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "apps/docs/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["packages/themes/src"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/docs/public"
              },
              {
                "glob": "**/*",
                "input": "apps/shared-assets",
                "output": "/assets"
              }
            ],
            "styles": ["dist/tokens/css/variables.css", "apps/docs/src/styles.scss"]
          }
        }
      }
    },
    "nightcall-ui": {
      "projectType": "library",
      "root": "projects/nightcall-ui",
      "sourceRoot": "projects/nightcall-ui/src",
      "prefix": "nc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/nightcall-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nightcall-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/nightcall-ui/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
